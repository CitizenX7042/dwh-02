# =============================================================================
# danor-etl — environment template
# Copy to .env on the approved ETL computer and fill in locally.
# NEVER commit a populated .env. NEVER put real passwords in this file.
# =============================================================================

# --- Source: Softwise SQL Server (read-only login) ---
SOURCE_SQL_SERVER=
SOURCE_SQL_PORT=
SOURCE_SQL_DATABASE=DANOR13
SOURCE_SQL_USERNAME=danor_etl_reader
SOURCE_SQL_PASSWORD=
SOURCE_SQL_ENCRYPT=
SOURCE_SQL_TRUST_SERVER_CERTIFICATE=

# --- Target: Azure SQL Database (write allowed) ---
TARGET_SQL_SERVER=
TARGET_SQL_PORT=1433
TARGET_SQL_DATABASE=
TARGET_SQL_USERNAME=
TARGET_SQL_PASSWORD=
TARGET_SQL_ENCRYPT=yes
TARGET_SQL_TRUST_SERVER_CERTIFICATE=no

# --- ETL runtime ---
ETL_SOURCE_SYSTEM=DANOR13
ETL_EXTRACT_CHUNK_SIZE=5000
ETL_INSERT_BATCH_SIZE=5000
ETL_QUERY_TIMEOUT_SECONDS=300
ETL_CONNECTION_TIMEOUT_SECONDS=30
ETL_LOG_LEVEL=INFO
ETL_LOG_DIR=
ETL_LOCK_DIR=
